[Unit]
Description=VOT House Finding - daily tenancy status sync
# On Vercel this same job runs via an HTTP endpoint guarded by CRON_SECRET,
# because Vercel Cron can only hit a URL. A real server can just run the
# management command directly - no HTTP round-trip or shared secret needed.
After=network.target postgresql.service

[Service]
Type=oneshot
User=santos
Group=www-data
WorkingDirectory=/srv/must_housing
EnvironmentFile=/srv/must_housing/.env
ExecStart=/srv/must_housing/venv/bin/python manage.py update_tenancy_statuses
