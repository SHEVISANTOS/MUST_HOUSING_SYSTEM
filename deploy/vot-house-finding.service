[Unit]
Description=VOT House Finding - Gunicorn application server
After=network.target postgresql.service
Wants=postgresql.service

[Service]
# Adjust User/Group and the paths below to match your server if different.
User=santos
Group=www-data
WorkingDirectory=/srv/must_housing
EnvironmentFile=/srv/must_housing/.env
RuntimeDirectory=vot-house-finding
LogsDirectory=vot-house-finding
ExecStart=/srv/must_housing/venv/bin/gunicorn \
    --config /srv/must_housing/deploy/gunicorn.conf.py \
    config.wsgi:application
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
