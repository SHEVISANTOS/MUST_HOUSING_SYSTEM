{
  "buildCommand": "python manage.py collectstatic --noinput && python manage.py migrate",
  "outputDirectory": "staticfiles",
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "crons": [
    {
      "path": "/bookings/tasks/update-tenancy-statuses/",
      "schedule": "0 3 * * *"
    }
  ]
}