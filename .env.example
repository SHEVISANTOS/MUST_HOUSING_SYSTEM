# Copy this file to .env and fill in real values. Never commit .env.

# General Settings
DJANGO_SECRET_KEY=change-me-generate-a-new-random-secret-key
DJANGO_DEBUG=True

# Database (Postgres/Neon connection string, read by dj_database_url)
DATABASE_URL=postgresql://username:password@host/dbname?sslmode=require

# Media storage (Cloudflare R2). Optional - leave unset for local dev to
# keep saving uploads to the local media/ folder instead. See DEPLOY_NOTES.md.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
