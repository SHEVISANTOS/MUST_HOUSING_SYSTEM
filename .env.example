# Copy this file to .env and fill in real values. Never commit .env.

# General Settings
DJANGO_SECRET_KEY=change-me-generate-a-new-random-secret-key
DJANGO_DEBUG=True

# Database (Postgres connection string, read by dj_database_url). On Vercel
# this is Neon; on a self-hosted Ubuntu server it's typically a local
# Postgres instance - see DEPLOY_NOTES.md.
DATABASE_URL=postgresql://username:password@host/dbname?sslmode=require

# Extra allowed hosts/CSRF origins for non-Vercel deployments (e.g. the
# Ubuntu server's IP or domain). Comma-separated, additive - leave unset on
# Vercel. See DEPLOY_NOTES.md.
DJANGO_ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=

# Media storage (Cloudflare R2). Optional - leave unset for local dev to
# keep saving uploads to the local media/ folder instead. See DEPLOY_NOTES.md.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Google Maps JS API key, used on the property detail page's location map.
# Optional - the map is hidden entirely if left unset. Restrict this key in
# the Google Cloud Console to the Maps JavaScript API and your site's
# domain(s)/referrers.
GOOGLE_MAPS_API_KEY=
